---
import { GITHUB_URL } from '../consts';
import { getUi, imprintPath, rssPath, type Language } from '../i18n/ui';

interface Props { language?: Language }
const { language = 'de' } = Astro.props;
const t = getUi(language);
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div>
		<p class="footer-brand">Open · Smart · Intuitive</p>
		<p>{t.footerCopy}</p>
	</div>
	<nav aria-label={t.footerNavigation}>
		<a href="https://osiris-app.de">OSIRIS</a>
		<a href="https://osiris-solutions.de">Solutions</a>
		<a href="https://osiris-portfolio.de">Portfolio</a>
		<a href="https://wiki.osiris-app.de">Wiki</a>
		<a href={GITHUB_URL}>GitHub</a>
		<!-- <a href={rssPath(language)}>RSS</a> -->
		<a href={imprintPath(language)}>{t.imprint}</a>
	</nav>
	<p class="copyright">© {year} OSIRIS Solutions GmbH</p>
</footer>

<style>
	.site-footer {
		display: grid;
		width: min(var(--content-width), calc(100% - 2rem));
		grid-template-columns: 1fr auto auto;
		align-items: end;
		margin: 5rem auto 0;
		padding: 2rem 0 3rem;
		border-top: 1px solid var(--line);
		gap: 2rem;
		color: var(--muted);
		font-size: 0.86rem;
	}

	p {
		margin: 0;
	}

	.footer-brand {
		color: var(--teal-700);
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	a {
		color: var(--text-soft);
		font-weight: 700;
		text-decoration: none;
	}

	@media (max-width: 760px) {
		.site-footer {
			width: calc(100% - 1.25rem);
			grid-template-columns: 1fr;
			align-items: start;
			gap: 1.25rem;
		}
	}
</style>
