---
import { GITHUB_URL } from '../consts';
import { authorsPath, getUi, homePath, rssPath, type Language } from '../i18n/ui';
import HeaderLink from './HeaderLink.astro';

interface Props {
	language?: Language;
	alternateUrl?: string;
}

const { language = 'de', alternateUrl } = Astro.props;
const t = getUi(language);
const otherLanguage: Language = language === 'de' ? 'en' : 'de';
const languageTarget = alternateUrl ?? homePath(otherLanguage);
---

<a class="skip-link" href="#content">{t.skipToContent}</a>
<header class="site-header">
	<nav aria-label={t.mainNavigation}>
		<a class="brand" href={homePath(language)} aria-label={t.homeLabel}>
			<img src="/OSIRIS-blog.svg" alt="" height="100" width="200" />
		</a>
		<div class="nav-links">
			<HeaderLink href={homePath(language)}>{t.posts}</HeaderLink>
			<HeaderLink href={authorsPath(language)}>{t.authors}</HeaderLink>
			<a href={rssPath(language)}>RSS</a>
			<a class="github-link" href={GITHUB_URL} target="_blank" rel="me noreferrer">
				GitHub <span aria-hidden="true">↗</span>
			</a>
			<div class="language-switch" role="group" aria-label={t.languageSwitch}>
				<a
					href={language === 'de' ? Astro.url.pathname : languageTarget}
					class:list={{ active: language === 'de' }}
					lang="de"
					aria-current={language === 'de' ? 'page' : undefined}>DE</a
				>
				<a
					href={language === 'en' ? Astro.url.pathname : languageTarget}
					class:list={{ active: language === 'en' }}
					lang="en"
					aria-current={language === 'en' ? 'page' : undefined}>EN</a
				>
			</div>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 10;
		border-bottom: 1px solid var(--line-soft);
		background: rgba(255, 255, 255, 0.94);
		backdrop-filter: blur(14px);
	}

	nav {
		display: flex;
		width: min(var(--content-width), calc(100% - 2rem));
		min-height: 5rem;
		align-items: center;
		justify-content: space-between;
		margin: 0 auto;
		gap: 2rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--teal-950);
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		text-decoration: none;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-links :global(a) {
		padding: 0.55rem 0.8rem;
		border-radius: 99px;
		color: var(--text-soft);
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
	}

	.nav-links :global(a:hover),
	.nav-links :global(a.active) {
		background: var(--teal-soft);
		color: var(--teal-950);
	}

	.nav-links .github-link {
		margin-left: 0.25rem;
		background: var(--teal-950);
		color: white;
	}

	.nav-links .github-link:hover {
		background: var(--teal-700);
		color: white;
	}

	.language-switch {
		display: flex;
		margin-left: 0.35rem;
		padding: 0.2rem;
		border: 1px solid var(--line-soft);
		border-radius: 99px;
		background: var(--surface-muted);
	}

	.nav-links .language-switch a {
		padding: 0.28rem 0.48rem;
		font-size: 0.72rem;
		letter-spacing: 0.04em;
	}

	.nav-links .language-switch a.active {
		background: var(--teal-900);
		color: white;
	}

	@media (max-width: 760px) {
		nav {
			width: calc(100% - 1.25rem);
			min-height: 4.5rem;
			gap: 0.5rem;
		}

		.brand img {
			width: 120px;
			height: auto;
		}

		.nav-links {
			gap: 0;
		}

		.nav-links :global(a) {
			padding-inline: 0.45rem;
			font-size: 0.76rem;
		}

		.nav-links .github-link,
		.nav-links > :global(a:nth-child(3)) {
			display: none;
		}

		.language-switch {
			margin-left: 0.15rem;
		}
	}

	@media (max-width: 480px) {
		.brand img {
			width: 92px;
		}

		.nav-links > :global(a:nth-child(2)) {
			display: none;
		}
	}
</style>
