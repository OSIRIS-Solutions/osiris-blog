---
import { GITHUB_URL } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<a class="skip-link" href="#content">Zum Inhalt springen</a>
<header class="site-header">
	<nav aria-label="Hauptnavigation">
		<a class="brand" href="/" aria-label="OSIRIS Blog – Startseite">
			<img src="/OSIRIS-blog.svg" alt="" height="100" width="200" />
		</a>
		<div class="nav-links">
			<HeaderLink href="/">Beiträge</HeaderLink>
			<HeaderLink href="/autorinnen/">Autor:innen</HeaderLink>
			<a href="/rss.xml">RSS</a>
			<a class="github-link" href={GITHUB_URL} target="_blank" rel="me noreferrer">
				GitHub <span aria-hidden="true">↗</span>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 10;
		border-bottom: 1px solid var(--line-soft);
		background: rgba(255, 255, 255, 0.94);
		backdrop-filter: blur(14px);
	}

	nav {
		display: flex;
		width: min(var(--content-width), calc(100% - 2rem));
		min-height: 5rem;
		align-items: center;
		justify-content: space-between;
		margin: 0 auto;
		gap: 2rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--teal-950);
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		text-decoration: none;
	}

	.brand strong {
		color: var(--teal-700);
		font-weight: 800;
	}

	.brand-mark {
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		border-radius: 50% 50% 46% 54%;
		background: var(--teal-700);
		color: white;
		font-size: 1.1rem;
		font-weight: 800;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-links :global(a) {
		padding: 0.55rem 0.8rem;
		border-radius: 99px;
		color: var(--text-soft);
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
	}

	.nav-links :global(a:hover),
	.nav-links :global(a.active) {
		background: var(--teal-soft);
		color: var(--teal-950);
	}

	.nav-links .github-link {
		margin-left: 0.25rem;
		background: var(--teal-950);
		color: white;
	}

	.nav-links .github-link:hover {
		background: var(--teal-700);
		color: white;
	}

	@media (max-width: 650px) {
		nav {
			width: calc(100% - 1.25rem);
			min-height: 4.5rem;
		}

		.brand span:last-child {
			display: none;
		}

		.nav-links {
			gap: 0;
		}

		.nav-links :global(a) {
			padding-inline: 0.55rem;
			font-size: 0.78rem;
		}

		.nav-links .github-link {
			display: none;
		}
	}
</style>
