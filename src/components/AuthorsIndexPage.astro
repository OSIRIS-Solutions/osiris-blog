---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import AuthorAvatar from './AuthorAvatar.astro';
import { authors, localizeAuthor } from '../data/authors';
import { authorsPath, getUi, type Language } from '../i18n/ui';

interface Props { language: Language }
const { language } = Astro.props;
const t = getUi(language);
const localizedAuthors = authors.map((author) => localizeAuthor(author, language));
const alternateUrl = authorsPath(language === 'de' ? 'en' : 'de');
---

<!doctype html>
<html lang={language}>
	<head>
		<BaseHead
			title={`${t.authors} · OSIRIS Blog`}
			description={t.authorsHeadline}
			language={language}
			alternateUrls={{ de: '/autorinnen/', en: '/en/authors/' }}
		/>
	</head>
	<body>
		<Header language={language} alternateUrl={alternateUrl} />
		<main id="content">
			<header class="page-head">
				<p>{t.perspectives}</p>
				<h1>{t.authorsHeadline}</h1>
			</header>
			<section class="author-grid" aria-label={t.allAuthors}>
				{localizedAuthors.map((author) => (
					<a class="author-card" href={authorsPath(language, author.id)}>
						<AuthorAvatar author={author} size="large" />
						<div>
							<h2>{author.name}</h2>
							<p class="role">{author.role}</p>
							<p>{author.bio}</p>
						</div>
						<span aria-hidden="true">→</span>
					</a>
				))}
			</section>
		</main>
		<Footer language={language} />
	</body>
</html>

<style>
	.page-head { max-width: 62rem; padding: clamp(4rem, 9vw, 8rem) 0 4rem; }
	.page-head p { margin: 0 0 1rem; color: var(--teal-700); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(3rem, 7vw, 6.5rem); letter-spacing: -0.055em; }
	.author-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
	.author-card { display: grid; grid-template-columns: auto 1fr auto; align-items: start; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1.5px solid var(--line); border-radius: var(--radius-card); background: var(--surface); color: inherit; gap: 1.5rem; text-decoration: none; transition: transform 180ms ease, box-shadow 180ms ease; }
	.author-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
	h2 { margin: 0 0 0.25rem; font-size: 1.65rem; }
	.author-card p { margin: 0.8rem 0 0; color: var(--text-soft); font-size: 0.95rem; }
	.author-card .role { margin: 0; color: var(--teal-700); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
	.author-card > span { color: var(--teal-700); font-size: 1.5rem; }
	@media (max-width: 850px) { .author-grid { grid-template-columns: 1fr; } }
	@media (max-width: 520px) { .author-card { grid-template-columns: auto 1fr; } .author-card > span { display: none; } }
</style>
