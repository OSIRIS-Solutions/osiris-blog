---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PostCard from './PostCard.astro';
import { SITE_TITLE } from '../consts';
import { getUi, homePath, tagsPath, type Language } from '../i18n/ui';
import { tagToSlug } from '../utils/tags';

interface Props { language: Language }
const { language } = Astro.props;
const t = getUi(language);
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.language === language)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tagMap = new Map<string, { label: string; count: number }>();
for (const post of posts) {
	const postTags = new Set<string>();
	for (const tag of post.data.tags) {
		const slug = tagToSlug(tag);
		if (postTags.has(slug)) continue;
		postTags.add(slug);
		const current = tagMap.get(slug);
		tagMap.set(slug, { label: current?.label ?? tag, count: (current?.count ?? 0) + 1 });
	}
}
const tags = [...tagMap.entries()]
	.map(([slug, tag]) => ({ slug, ...tag }))
	.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, language));
const visibleTagCount = 8;
const visibleTags = tags.slice(0, visibleTagCount);
const extraTags = tags.slice(visibleTagCount);
const featuredIndex = posts.findIndex((post) => post.data.heroImage);
const [headlineFirst, headlineSecond] = t.headline.split('|');
---

<!doctype html>
<html lang={language}>
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={t.intro}
			language={language}
			alternateUrls={{ de: '/', en: '/en/' }}
		/>
	</head>
	<body>
		<Header language={language} alternateUrl={homePath(language === 'de' ? 'en' : 'de')} />
		<main id="content">
			<header class="blog-intro">
				<div>
					<p class="eyebrow">{t.eyebrow}</p>
					<h1>{headlineFirst}<br />{headlineSecond}</h1>
				</div>
				<p class="intro-copy">{t.intro}</p>
			</header>

			<nav class="tag-filter" aria-label={t.filterLabel} data-tag-filter>
				<a class="active" href={homePath(language)}>{t.allPostsLabel}</a>
				{visibleTags.map((tag) => (
					<a href={tagsPath(language, tag.slug)}>
						<span>#{tag.label.replace(/\s+/g, '')}</span>
						<span class="tag-count" aria-hidden="true">{tag.count}</span>
						<span class="sr-only"> · {tag.count} {tag.count === 1 ? t.post : t.postsPlural}</span>
					</a>
				))}
				{extraTags.length > 0 && (
					<>
						<button
							type="button"
							class="more-tags-toggle"
							aria-expanded="false"
							aria-controls={`extra-tags-${language}`}
							aria-label={t.showMoreTags}
							data-show-label={t.showMoreTags}
							data-hide-label={t.showFewerTags}
						>
							<span aria-hidden="true">…</span>
						</button>
						<div class="extra-tags" id={`extra-tags-${language}`} hidden>
							{extraTags.map((tag) => (
								<a href={tagsPath(language, tag.slug)}>
									<span>#{tag.label.replace(/\s+/g, '')}</span>
									<span class="tag-count" aria-hidden="true">{tag.count}</span>
									<span class="sr-only"> · {tag.count} {tag.count === 1 ? t.post : t.postsPlural}</span>
								</a>
							))}
						</div>
					</>
				)}
			</nav>

			<section class="post-grid" aria-label={t.allPosts}>
				{posts.map((post) => <PostCard post={post} />)}
			</section>
		</main>
		<Footer language={language} />
	</body>
</html>

<script>
	document.querySelectorAll<HTMLElement>('[data-tag-filter]').forEach((filter) => {
		const toggle = filter.querySelector<HTMLButtonElement>('.more-tags-toggle');
		const extraTags = filter.querySelector<HTMLElement>('.extra-tags');
		if (!toggle || !extraTags) return;

		toggle.addEventListener('click', () => {
			const expanded = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!expanded));
			toggle.setAttribute('aria-label', expanded ? toggle.dataset.showLabel ?? '' : toggle.dataset.hideLabel ?? '');
			extraTags.hidden = expanded;
		});
	});
</script>

<style>
	.blog-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.7fr);
		align-items: end;
		padding: clamp(3.5rem, 9vw, 8rem) 0 clamp(2.5rem, 6vw, 5rem);
		gap: 3rem;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--teal-700);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 7vw, 7rem);
		line-height: 0.88;
	}

	.intro-copy {
		margin: 0;
		padding-bottom: 0.4rem;
		color: var(--text-soft);
		font-size: clamp(1.05rem, 1.7vw, 1.35rem);
		line-height: 1.5;
	}

	.tag-filter {
		display: flex;
		flex-wrap: wrap;
		padding: 0 0 1.5rem;
		gap: 0.45rem;
	}

	.tag-filter a,
	.more-tags-toggle {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: 99px;
		background: var(--surface);
		color: var(--text-soft);
		font-family: inherit;
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}

	.more-tags-toggle {
		min-width: 2.55rem;
		justify-content: center;
		cursor: pointer;
		font-size: 1.05rem;
		line-height: 1;
	}

	.extra-tags {
		display: contents;
	}

	.extra-tags[hidden] {
		display: none;
	}

	.tag-count {
		min-width: 1.35rem;
		margin-left: 0.45rem;
		padding: 0.08rem 0.38rem;
		border-radius: 99px;
		background: var(--surface-muted);
		color: var(--muted);
		font-size: 0.68rem;
		line-height: 1.35;
		text-align: center;
	}

	.tag-filter a:hover,
	.tag-filter a.active,
	.more-tags-toggle:hover,
	.more-tags-toggle[aria-expanded='true'] {
		border-color: var(--teal-900);
		background: var(--teal-900);
		color: white;
	}

	.tag-filter a:hover .tag-count,
	.tag-filter a.active .tag-count {
		background: rgba(255, 255, 255, 0.18);
		color: white;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.8rem, 1.5vw, 1.35rem);
	}

	@media (max-width: 1100px) {
		.post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (max-width: 700px) {
		.blog-intro {
			grid-template-columns: 1fr;
			padding-top: 3.5rem;
			gap: 1.5rem;
		}

		h1 { font-size: clamp(3.1rem, 17vw, 5rem); }
		.post-grid { grid-template-columns: 1fr; }
	}
</style>
