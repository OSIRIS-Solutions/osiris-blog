---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PostCard from './PostCard.astro';
import { SITE_TITLE } from '../consts';
import { getUi, homePath, tagsPath, type Language } from '../i18n/ui';
import { tagToSlug } from '../utils/tags';

interface Props { language: Language }
const { language } = Astro.props;
const t = getUi(language);
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.language === language)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tagMap = new Map<string, string>();
for (const tag of posts.flatMap((post) => post.data.tags)) tagMap.set(tagToSlug(tag), tag);
const tags = [...tagMap.values()].sort((a, b) => a.localeCompare(b, language));
// const featuredIndex = posts.findIndex((post) => post.data.heroImage);
const [headlineFirst, headlineSecond] = t.headline.split('|');
---

<!doctype html>
<html lang={language}>
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={t.intro}
			language={language}
			alternateUrls={{ de: '/', en: '/en/' }}
		/>
	</head>
	<body>
		<Header language={language} alternateUrl={homePath(language === 'de' ? 'en' : 'de')} />
		<main id="content">
			<header class="blog-intro">
				<div>
					<p class="eyebrow">{t.eyebrow}</p>
					<h1>{headlineFirst}<br />{headlineSecond}</h1>
				</div>
				<p class="intro-copy">{t.intro}</p>
			</header>

			<nav class="tag-filter" aria-label={t.filterLabel}>
				<a class="active" href={homePath(language)}>{t.allPostsLabel}</a>
				{tags.slice(0, 8).map((tag) => <a href={tagsPath(language, tagToSlug(tag))}>#{tag.replace(/\s+/g, '')}</a>)}
			</nav>

			<section class="post-grid" aria-label={t.allPosts}>
				{posts.map((post) => <PostCard post={post} />)}
			</section>
		</main>
		<Footer language={language} />
	</body>
</html>

<style>
	.blog-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.7fr);
		align-items: end;
		padding: clamp(3.5rem, 9vw, 8rem) 0 clamp(2.5rem, 6vw, 5rem);
		gap: 3rem;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--teal-700);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 7vw, 7rem);
		line-height: 0.88;
	}

	.intro-copy {
		margin: 0;
		padding-bottom: 0.4rem;
		color: var(--text-soft);
		font-size: clamp(1.05rem, 1.7vw, 1.35rem);
		line-height: 1.5;
	}

	.tag-filter {
		display: flex;
		overflow-x: auto;
		padding: 0 0 1.5rem;
		gap: 0.45rem;
		scrollbar-width: thin;
	}

	.tag-filter a {
		padding: 0.5rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: 99px;
		background: var(--surface);
		color: var(--text-soft);
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}

	.tag-filter a:hover,
	.tag-filter a.active {
		border-color: var(--teal-900);
		background: var(--teal-900);
		color: white;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.8rem, 1.5vw, 1.35rem);
	}

	@media (max-width: 1100px) {
		.post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (max-width: 700px) {
		.blog-intro {
			grid-template-columns: 1fr;
			padding-top: 3.5rem;
			gap: 1.5rem;
		}

		h1 { font-size: clamp(3.1rem, 17vw, 5rem); }
		.post-grid { grid-template-columns: 1fr; }
	}
</style>
