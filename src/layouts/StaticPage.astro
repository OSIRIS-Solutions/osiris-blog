---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { Language } from '../i18n/ui';

interface Props {
	language: Language;
	title: string;
	description: string;
	eyebrow?: string;
	alternateUrl: string;
	alternateUrls: Partial<Record<Language, string>>;
}

const { language, title, description, eyebrow, alternateUrl, alternateUrls } = Astro.props;
---

<!doctype html>
<html lang={language}>
	<head>
		<BaseHead
			title={`${title} · OSIRIS Blog`}
			description={description}
			language={language}
			alternateUrls={alternateUrls}
		/>
	</head>
	<body>
		<Header language={language} alternateUrl={alternateUrl} />
		<main id="content">
			<article class="static-page">
				<header>
					{eyebrow && <p class="eyebrow">{eyebrow}</p>}
					<h1>{title}</h1>
					<p class="description">{description}</p>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer language={language} />
	</body>
</html>

<style>
	.static-page {
		width: min(var(--reading-width), 100%);
		margin: 0 auto;
		padding: clamp(4rem, 9vw, 8rem) 0 2rem;
	}

	.static-page header {
		margin-bottom: clamp(3rem, 7vw, 5rem);
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--teal-700);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(3.5rem, 9vw, 7rem);
		letter-spacing: -0.055em;
	}

	.description {
		max-width: 40rem;
		margin: 1.5rem 0 0;
		color: var(--text-soft);
		font-size: 1.15rem;
	}

	.prose :global(h2) {
		margin: 2.75rem 0 0.75rem;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
	}

	.prose :global(p) {
		margin: 0 0 1.25rem;
	}

	.prose :global(.placeholder) {
		padding: 1.5rem;
		border: 1.5px dashed var(--line);
		border-radius: var(--radius-card);
		background: var(--surface);
		color: var(--text-soft);
	}
</style>
