---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AuthorAvatar from '../components/AuthorAvatar.astro';
import { getAuthor, localizeAuthor } from '../data/authors';
import { tagToSlug } from '../utils/tags';
import { authorsPath, getUi, homePath, tagsPath } from '../i18n/ui';

type Props = CollectionEntry<'blog'>['data'] & { alternateUrl?: string };

const { title, description, pubDate, updatedDate, heroImage, authors, tags, language, alternateUrl } = Astro.props;
const postAuthors = authors.map((id) => localizeAuthor(getAuthor(id), language));
const t = getUi(language);
const alternateUrls = language === 'de'
	? { de: Astro.url.pathname, ...(alternateUrl ? { en: alternateUrl } : {}) }
	: { en: Astro.url.pathname, ...(alternateUrl ? { de: alternateUrl } : {}) };
---

<!doctype html>
<html lang={language}>
	<head>
		<BaseHead title={`${title} · OSIRIS Blog`} description={description} image={heroImage} type="article" language={language} alternateUrls={alternateUrls} />
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
	</head>
	<body>
		<Header language={language} alternateUrl={alternateUrl} />
		<main id="content">
			<article>
				<header class:list={['article-head', { 'with-hero': heroImage }]}> 
					<div class="article-title">
						<a class="back" href={homePath(language)}>← {t.allPosts}</a>
						<div class="meta">
							<span><FormattedDate date={pubDate} language={language} /></span>
							{language === 'en' && <span>English</span>}
						</div>
						<h1>{title}</h1>
						<p class="description">{description}</p>
						<div class="byline">
							<div class="avatar-stack" aria-hidden="true">
								{postAuthors.map((author) => <AuthorAvatar author={author} />)}
							</div>
							<div>
								<span>{t.by}</span>
								{postAuthors.map((author, index) => (
									<><a href={authorsPath(language, author.id)}>{author.name}</a>{index < postAuthors.length - 1 ? ', ' : ''}</>
								))}
							</div>
						</div>
					</div>
					{heroImage && (
						<div class="hero-image">
							<Image src={heroImage} alt="" widths={[720, 1080, 1440]} sizes="(min-width: 900px) 52vw, 100vw" />
						</div>
					)}
				</header>

				<div class="article-body">
					<div class="prose">
						{updatedDate && <p class="updated">{t.updated} <FormattedDate date={updatedDate} language={language} /></p>}
						<slot />
					</div>

					<footer class="article-footer">
						<div class="article-tags" aria-label="Tags">
							{tags.map((tag) => <a href={tagsPath(language, tagToSlug(tag))}>#{tag.replace(/\s+/g, '')}</a>)}
						</div>
						{postAuthors.map((author) => (
							<a class="author-note" href={authorsPath(language, author.id)}>
								<AuthorAvatar author={author} size="large" />
								<span>
									<small>{t.writtenBy}</small>
									<strong>{author.name}</strong>
									<span>{author.bio}</span>
								</span>
								<b aria-hidden="true">→</b>
							</a>
						))}
					</footer>
				</div>
			</article>
		</main>
		<Footer language={language} />
	</body>
</html>

<style>
	main {
		overflow-x: clip;
	}

	.article-head {
		display: flex;
		flex-direction: column;
		width: min(56rem, 100%);
		margin: 0 auto;
		padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(3.5rem, 7vw, 5.5rem);
	}

	.article-title {
		display: flex;
		flex-direction: column;
	}

	.back {
		align-self: flex-start;
		margin-bottom: clamp(2rem, 5vw, 4rem);
		font-size: 0.85rem;
		font-weight: 800;
		text-decoration: none;
	}

	.meta {
		display: flex;
		margin-bottom: 1.2rem;
		gap: 1rem;
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 5.5vw, 4.5rem);
		line-height: 0.98;
	}

	.description {
		max-width: 44rem;
		margin: 1.5rem 0 2rem;
		color: var(--text-soft);
		font-size: clamp(1.05rem, 1.6vw, 1.3rem);
		line-height: 1.5;
	}

	.byline {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		font-size: 0.86rem;
		font-weight: 700;
	}

	.byline > div:last-child {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.25rem;
	}

	.byline span {
		color: var(--muted);
	}

	.avatar-stack {
		display: flex;
	}

	.avatar-stack :global(.author-avatar + .author-avatar) {
		margin-left: -0.65rem;
	}

	.hero-image {
		aspect-ratio: 16 / 9;
		margin-top: clamp(2.5rem, 5vw, 4rem);
		overflow: hidden;
		border-radius: var(--radius-card);
		background: var(--teal-soft);
	}

	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
		object-fit: cover;
		object-position: top center;
	}

	.article-body {
		width: min(var(--reading-width), 100%);
		margin: 0 auto;
	}

	.prose {
		padding-bottom: 3rem;
		color: #293e3c;
	}

	.prose :global(h2) {
		margin: 3.2rem 0 1rem;
		font-size: clamp(1.8rem, 4vw, 2.65rem);
	}

	.prose :global(h3) {
		margin: 2.5rem 0 0.8rem;
		font-size: 1.45rem;
	}

	.prose :global(p),
	.prose :global(li) {
		font-size: 1.08rem;
	}

	.prose :global(p) {
		margin: 0 0 1.4rem;
	}

	.prose :global(li + li) {
		margin-top: 0.5rem;
	}

	.prose :global(img),
	.prose :global(.article-figure) {
		display: block;
		width: min(62rem, calc(100vw - 2rem));
		max-width: none;
		margin: 2.5rem 50%;
		transform: translateX(-50%);
	}

	.prose :global(img) {
		border: 1px solid var(--line-soft);
		border-radius: var(--radius-card);
	}

	.prose :global(.article-figure img) {
		width: 100%;
		margin: 0;
		transform: none;
	}

	.prose :global(.article-figure figcaption) {
		max-width: var(--reading-width);
		margin: 0.8rem auto 0;
		padding-inline: 0.25rem;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.prose :global(.table-scroll) {
		width: min(62rem, calc(100vw - 2rem));
		margin: 2.5rem 50%;
		overflow-x: auto;
		transform: translateX(-50%);
		border: 1px solid var(--line-soft);
		border-radius: 1rem;
		background: var(--surface);
		box-shadow: 0 0.4rem 1.5rem rgba(7, 63, 61, 0.04);
		overscroll-behavior-inline: contain;
		scrollbar-width: thin;
	}

	.prose :global(table) {
		width: max(100%, 48rem);
		border-collapse: collapse;
		font-size: 0.94rem;
		line-height: 1.45;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 0.9rem 1rem;
		border-right: 1px solid var(--line-soft);
		border-bottom: 1px solid var(--line-soft);
		text-align: left;
		vertical-align: top;
	}

	.prose :global(th) {
		background: var(--teal-soft);
		color: var(--teal-950);
		font-weight: 800;
	}

	.prose :global(tbody tr:nth-child(even) td) {
		background: var(--surface-muted);
	}

	.prose :global(tr > :last-child) {
		border-right: 0;
	}

	.prose :global(tbody tr:last-child td) {
		border-bottom: 0;
	}

	.prose :global(blockquote) {
		margin: 2.5rem 0;
		padding: 1.5rem 1.75rem;
		border-left: 0.35rem solid var(--orange);
		border-radius: 0 var(--radius-card) var(--radius-card) 0;
		background: var(--orange-soft);
		color: var(--teal-950);
		font-size: 1.1rem;
		font-weight: 500;
	}
	/* last p in blockquote no bottom margin */
	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.prose :global(code) {
		padding: 0.15em 0.35em;
		border-radius: 0.3rem;
		background: var(--teal-soft);
	}

	.prose :global(pre) {
		overflow-x: auto;
		padding: 1.5rem;
		border-radius: 1rem;
	}

	.prose :global(pre code) {
		padding: 0;
		background: transparent;
	}

	.updated {
		color: var(--muted);
		font-size: 0.86rem !important;
	}

	.article-footer {
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		margin-bottom: 2rem;
		gap: 0.55rem;
	}

	.article-tags a {
		padding: 0.45rem 0.75rem;
		border-radius: 99px;
		background: var(--teal-soft);
		font-size: 0.8rem;
		font-weight: 800;
		text-decoration: none;
	}

	.author-note {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		margin-top: 1rem;
		padding: 1.5rem;
		border: 1.5px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--surface);
		color: inherit;
		gap: 1.25rem;
		text-decoration: none;
	}

	.author-note small,
	.author-note strong,
	.author-note span span {
		display: block;
	}

	.author-note small {
		color: var(--teal-700);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.author-note strong {
		color: var(--teal-950);
		font-size: 1.15rem;
	}

	.author-note span span {
		margin-top: 0.2rem;
		color: var(--text-soft);
		font-size: 0.85rem;
		line-height: 1.45;
	}

	.author-note b {
		color: var(--teal-700);
		font-size: 1.4rem;
	}

	@media (max-width: 600px) {
		.article-head { padding-top: 2.5rem; }
		.hero-image { border-radius: 1.1rem; }
		.author-note { grid-template-columns: auto 1fr; }
		.author-note b { display: none; }
	}
</style>
