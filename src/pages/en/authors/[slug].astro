---
import AuthorProfilePage from '../../../components/AuthorProfilePage.astro';
import { authors, type Author } from '../../../data/authors';

export function getStaticPaths() {
	return authors.map((author) => ({ params: { slug: author.id }, props: { author } }));
}

interface Props { author: Author }
const { author } = Astro.props;
---

<AuthorProfilePage language="en" author={author} />
